class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None

class BSTDasar:
    def __init__(self):
        self.root = None

    def insert_node(self, root, key):
        if root is None:
            return Node(key)
        if key < root.key:
            root.left = self.insert_node(root.left, key)
        elif key > root.key:
            root.right = self.insert_node(root.right, key)
        return root

    def insert(self, key):
        self.root = self.insert_node(self.root, key)

    def search_node(self, root, key):
        if root is None:
            return False
        if root.key == key:
            return True
        if key < root.key:
            return self.search_node(root.left, key)
        return self.search_node(root.right, key)

    def search(self, key):
        return self.search_node(self.root, key)

    def inorder(self, root):
        if root is None:
            return
        self.inorder(root.left)
        print(root.key, end=" ")
        self.inorder(root.right)

    def preorder(self, root):
        if root is None:
            return
        print(root.key, end=" ")
        self.preorder(root.left)
        self.preorder(root.right)

    def postorder(self, root):
        if root is None:
            return
        self.postorder(root.left)
        self.postorder(root.right)
        print(root.key, end=" ")

    def find_min(self, root):
        if root is None:
            return -1
        current = root
        while current.left is not None:
            current = current.left
        return current.key

    def find_max(self, root):
        if root is None:
            return -1
        current = root
        while current.right is not None:
            current = current.right
        return current.key

    def count_nodes(self, root):
        if root is None:
            return 0
        return 1 + self.count_nodes(root.left) + self.count_nodes(root.right)

    def sum_nodes(self, root):
        if root is None:
            return 0
        return root.key + self.sum_nodes(root.left) + self.sum_nodes(root.right)

def main():
    bst = BSTDasar()
    pilih = 0
    while pilih != 10:
        print("\n=== SISTEM INFORMASI NILAI UJIAN SEKOLAH ===")
        print("1. Tambah Nilai Ujian Baru")
        print("2. Cari Nilai Ujian Siswa")
        print("3. Tampilkan Urutan Nilai Terkecil - Terbesar (Inorder)")
        print("4. Cetak Struktur Nilai (Preorder)")
        print("5. Cetak Struktur Nilai (Postorder)")
        print("6. Lihat Nilai Ujian Terendah")
        print("7. Lihat Nilai Ujian Tertinggi")
        print("8. Hitung Jumlah Siswa yang Ikut Ujian")
        print("9. Hitung Total Akumulasi Nilai Kelas")
        print("10. Keluar")
        try:
            pilih = int(input("Pilih Menu (1-10): "))
        except ValueError:
            print("Input tidak valid! Silakan pilih nomor menu.")
            continue
        if pilih == 1:
            try:
                x = int(input("Masukkan nilai ujian siswa: "))
                bst.insert(x)
                print(f"Nilai ujian {x} berhasil dimasukkan ke sistem.")
            except ValueError:
                print("Input tidak valid! Harus berupa angka.")
        elif pilih == 2:
            try:
                x = int(input("Masukkan nilai ujian yang dicari: "))
                if bst.search(x):
                    print(f"Hasil: Ada siswa yang mendapatkan nilai {x}.")
                else:
                    print(f"Hasil: Tidak ada siswa yang mendapatkan nilai {x}.")
            except ValueError:
                print("Input tidak valid!")
        elif pilih == 3:
            print("Daftar nilai siswa terurut: ", end="")
            bst.inorder(bst.root)
            print()
        elif pilih == 4:
            print("Urutan penelusuran Preorder: ", end="")
            bst.preorder(bst.root)
            print()
        elif pilih == 5:
            print("Urutan penelusuran Postorder: ", end="")
            bst.postorder(bst.root)
            print()
        elif pilih == 6:
            print(f"Nilai ujian terendah: {bst.find_min(bst.root)}")
        elif pilih == 7:
            print(f"Nilai ujian tertinggi: {bst.find_max(bst.root)}")
        elif pilih == 8:
            print(f"Jumlah total siswa yang dinilai: {bst.count_nodes(bst.root)} siswa")
        elif pilih == 9:
            print(f"Total seluruh nilai ujian di kelas: {bst.sum_nodes(bst.root)}")
        elif pilih == 10:
            print("Program pencatatan nilai ujian selesai.")
        else:
            print("Pilihan menu tidak valid!")

if __name__ == "__main__":
    main()