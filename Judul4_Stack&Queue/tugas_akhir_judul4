class AntrianWarung:
    def __init__(self, kapasitas=10):
        self.MAXN = kapasitas
        self.q = [None] * self.MAXN
        self.front_idx = -1
        self.rear_idx = -1
        self.counter = 0

    def is_empty(self):
        return self.front_idx == -1

    def is_full(self):
        return (self.rear_idx + 1) % self.MAXN == self.front_idx

    def enqueue(self, nama, jumlah):
        if self.is_full():
            print("Antrian penuh! Kapasitas maksimal 10 kelompok.");
            return
        self.counter += 1
        tamu = {"nomor": f"A{self.counter:02d}", "nama": nama, "jumlah": jumlah}
        if self.is_empty():
            self.front_idx = self.rear_idx = 0
        else:
            self.rear_idx = (self.rear_idx + 1) % self.MAXN
        self.q[self.rear_idx] = tamu
        print(f"{nama} terdaftar! Nomor antrian: {tamu['nomor']}")

    def dequeue(self):
        if self.is_empty():
            print("Antrian kosong! Tidak ada tamu yang menunggu.");
            return
        t = self.q[self.front_idx]
        print(f"Memanggil : {t['nomor']} - {t['nama']} ({t['jumlah']} orang)")
        if self.front_idx == self.rear_idx:
            self.front_idx = self.rear_idx = -1
        else:
            self.front_idx = (self.front_idx + 1) % self.MAXN

    def peek(self):
        if self.is_empty():
            print("Antrian kosong!");
            return
        t = self.q[self.front_idx]
        print(f"Berikutnya: {t['nomor']} - {t['nama']} ({t['jumlah']} orang)")

    def display(self):
        if self.is_empty():
            print("Antrian kosong!");
            return
        print("\n  Isi antrian: ")
        i, pos = self.front_idx, 1
        while True:
            t = self.q[i]
            print(f"  [{pos}] {t['nomor']} - {t['nama']} ({t['jumlah']} orang)")
            if i == self.rear_idx:
                break
            i = (i + 1) % self.MAXN
            pos += 1

def main():
    antrian = AntrianWarung(kapasitas=10)
    pilih = 0
    while pilih != 5:
        print("\n  ==========================================")
        print("       ANTRIAN WARUNG MAK ENAH  ")
        print("  ==========================================")
        print("  1. Daftarkan Tamu Baru")
        print("  2. Panggil Tamu (Meja Tersedia)")
        print("  3. Lihat Tamu Berikutnya")
        print("  4. Tampilkan Semua Antrian")
        print("  5. Keluar")
        print("  ------------------------------------------")
        try:
            pilih = int(input("  Pilih [1-5]: "))
        except ValueError:
            print("Input tidak valid! Silahkan coba lagi");
            continue

        if pilih == 1:
            nama = input("Nama tamu: ").strip()
            if not nama:
                print("Nama tidak boleh kosong!");
                continue
            try:
                jumlah = int(input("Jumlah orang: "))
                if jumlah <= 0:
                    print("Jumlah harus lebih dari 0!");
                    continue
            except ValueError:
                print("Input tidak valid!");
                continue
            antrian.enqueue(nama, jumlah)
        elif pilih == 2: 
            antrian.dequeue()
        elif pilih == 3: 
            antrian.peek()
        elif pilih == 4: 
            antrian.display()
        elif pilih == 5: 
            print("\n  Terima kasih! Sampai jumpa di Warung Mak Enah! \n")
        else: print("Pilihan tidak valid!")


if __name__ == "__main__":
    main()